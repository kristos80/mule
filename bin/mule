#!/usr/bin/env php
<?php
declare(strict_types=1);

use Composer\Autoload\ClassLoader;
use Kristos80\Mule\Console\Application;
use Kristos80\Mule\External\ComposerClasses;
use Kristos80\Mule\External\PhpFilesystem;
use Kristos80\Mule\External\PhpRandom;
use Kristos80\Mule\External\ShellProcesses;
use Kristos80\Mule\External\StreamOutput;

$directory = getcwd() ?: __DIR__;
$loader = NULL;

// Mule's own classes first — installed as a dependency, or being worked on
// directly — and the project's last, because that is the loader that knows
// where its test classes live and half of every cache key is a digest over
// them. Composer's autoload.php returns the one loader it has built, so asking
// for the same file twice is the same object, and asking for the project's
// after mule's is what makes a run from somewhere else work.
foreach([__DIR__ . "/../../../autoload.php", __DIR__ . "/../vendor/autoload.php", "{$directory}/vendor/autoload.php"] as $autoload) {
	if(is_file($autoload)) {
		$loader = require $autoload;
	}
}

if(!$loader instanceof ClassLoader) {
	fwrite(STDERR, "mule: no Composer autoloader found. Install mule with composer require --dev kristos80/mule.\n");

	exit(1);
}

$application = new Application(
	new PhpFilesystem(),
	new ShellProcesses(),
	new ComposerClasses($loader),
	new PhpRandom(),
	new StreamOutput(STDOUT),
	new StreamOutput(STDERR),
);

// `$argv ?? []` rather than `$argv`: the CLI always defines it, but whether a
// static analyser believes that depends on the `register_argc_argv` setting of
// whichever runtime the analyser itself happens to be running on — which turned
// one matrix leg red and the other green for the same bytes.
exit($application->run(array_values(array_slice($argv ?? [], 1)), $directory));
