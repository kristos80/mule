{
    "name": "kristos80/mule",
    "description": "A committed, content-hashed verdict cache for PHP mutation testing: mutate only the files whose score can no longer be trusted.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "mutation testing",
        "infection",
        "cache",
        "ci"
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-xmlwriter": "*",
        "infection/infection": "0.32.7",
        "phpunit/php-code-coverage": "^14.5.2",
        "phpunit/phpunit": "^13.1.14"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "tomasvotruba/cognitive-complexity": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Kristos80\\Mule\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kristos80\\Mule\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G --no-progress",
        "test": "./vendor/bin/phpunit",
        "test:coverage": "herd coverage ./vendor/bin/phpunit --coverage-text --coverage-xml=.cov/coverage-xml --log-junit=.cov/junit.xml --exclude-source-from-xml-coverage",
        "test:mutate": "./vendor/bin/infection --coverage=.cov --skip-initial-tests --threads=max --with-timeouts --min-msi=100 --min-covered-msi=100"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
