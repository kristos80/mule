{
	"name": "kristos80/mule",
	"description": "WIP. A committed, content-hashed verdict cache for PHP mutation testing: mutate only the files whose score can no longer be trusted.",
	"type": "library",
	"license": "MIT",
	"keywords": [
		"mutation testing",
		"infection",
		"cache",
		"ci"
	],
	"require": {
		"php": "^8.4",
		"ext-dom": "*",
		"ext-json": "*",
		"infection/infection": "^0.32",
		"phpunit/phpunit": "^12.0 || ^13.0"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.3",
		"tomasvotruba/cognitive-complexity": "^1.3"
	},
	"autoload": {
		"psr-4": {
			"Kristos80\\Mule\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Kristos80\\Mule\\Tests\\": "tests"
		}
	},
	"bin": [
		"bin/mule"
	],
	"scripts": {
		"analyse": "phpstan analyse --memory-limit=2G --no-progress",
		"test": "./vendor/bin/phpunit",
		"test:integration": "./vendor/bin/phpunit --configuration=phpunit.integration.xml",
		"test:coverage": "herd coverage ./vendor/bin/phpunit --coverage-text",
		"test:mutate": "herd coverage bin/mule full",
		"test:mutate:new": "herd coverage bin/mule new",
		"test:mutate:status": "php bin/mule status"
	},
	"config": {
		"allow-plugins": {
			"infection/extension-installer": true
		},
		"process-timeout": 0,
		"sort-packages": true
	},
	"minimum-stability": "stable"
}
