{
	"name": "kristos80/mule",
	"description": "A committed, content-hashed verdict cache for PHP mutation testing: mutate only the files whose score can no longer be trusted.",
	"type": "library",
	"license": "MIT",
	"keywords": [
		"mutation testing",
		"infection",
		"cache",
		"ci"
	],
	"require": {
		"php": "^8.4",
		"ext-dom": "*",
		"ext-json": "*"
	},
	"require-dev": {
		"infection/infection": "^0.32",
		"phpstan/phpstan": "^2.3",
		"phpunit/phpunit": "^12.0",
		"tomasvotruba/cognitive-complexity": "^1.3"
	},
	"autoload": {
		"psr-4": {
			"Kristos80\\Mule\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Kristos80\\Mule\\Tests\\": "tests"
		}
	},
	"bin": [
		"bin/mule"
	],
	"scripts": {
		"analyse": "phpstan analyse --memory-limit=2G --no-progress",
		"test": "./vendor/bin/phpunit",
		"test:integration": "./vendor/bin/phpunit --configuration=phpunit.integration.xml",
		"test:coverage": [
			"herd coverage ./vendor/bin/phpunit --coverage-clover=.phpunit.cache/clover.xml --coverage-text",
			"@test:coverage:gate"
		],
		"test:coverage:gate": "php -r '$m = simplexml_load_file(\".phpunit.cache/clover.xml\")->project->metrics; $s = (int) $m[\"statements\"]; $c = (int) $m[\"coveredstatements\"]; echo \"mule: {$c} of {$s} statements covered\\n\"; exit($s === $c ? 0 : 1);'",
		"test:mutate": "php bin/mule full",
		"test:mutate:new": "php bin/mule new",
		"test:mutate:status": "php bin/mule status"
	},
	"config": {
		"allow-plugins": {
			"infection/extension-installer": true
		},
		"process-timeout": 0,
		"sort-packages": true
	},
	"minimum-stability": "stable"
}
