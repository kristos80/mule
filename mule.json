	"support": [
		"tests/Support"
	],
	"exclude": [
		"src/Console/Assembly.php",
		"src/External/ClassesInterface.php",
		"src/External/ComposerClasses.php",
		"src/External/CoverageReportInterface.php",
		"src/External/EnvironmentInterface.php",
		"src/External/FilesystemInterface.php",
		"src/External/LinesInterface.php",
		"src/External/OutputInterface.php",
		"src/External/PhpCoverageReport.php",
		"src/External/PhpEnvironment.php",
		"src/External/PhpFilesystem.php",
		"src/External/PhpLines.php",
