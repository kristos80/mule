{
	"source": "src",
	"tests": "tests/Unit",
	"support": [
		"tests/Support"
	],
	"exclude": [
		"src/External/ComposerClasses.php",
		"src/External/PhpCoverageReport.php",
		"src/External/PhpEnvironment.php",
		"src/External/PhpFilesystem.php",
		"src/External/PhpLines.php",
		"src/External/ShellProcesses.php",
		"src/External/StreamOutput.php",
		"src/External/StreamProgress.php"
	],
	"mutant-free": [
		"src/Console/Assembly.php",
		"src/Doctor/Examination.php",
		"src/Runner/Measured.php"
	],
	"mutators": {
		"@default": true,
		"@identical": true
	},
	"min-coverage": 100,
	"threads": "max"
}
