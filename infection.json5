{
	"$schema": "vendor/infection/infection/resources/schema.json",
	"source": {
		"directories": ["src"],
		// The same files phpunit.xml excludes from coverage: the external layer,
		// one primitive per method, so every mutant in them is either unkillable
		// or scores as uncovered. See docs/keying.md and CLAUDE.md.
		"excludes": [
			"External/ComposerClasses.php",
			"External/PhpCoverageReport.php",
			"External/PhpEnvironment.php",
			"External/PhpFilesystem.php",
			"External/PhpLines.php",
			"External/ShellProcesses.php",
			"External/StreamOutput.php"
		]
	},
	"mutators": { "@default": true, "@identical": true },
	"logs": { "json": ".mule/infection.json" },
	"testFramework": "phpunit",
	"tmpDir": ".infection"
}
