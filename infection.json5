{
	"$schema": "vendor/infection/infection/resources/schema.json",
	"source": { "directories": ["src"] },
	"mutators": { "@default": true, "@identical": true },
	"logs": { "json": ".mule/infection.json" },
	"testFramework": "phpunit",
	"tmpDir": ".infection",
	// Named explicitly because Infection restarts itself through
	// composer/xdebug-handler under a stripped ini and then cannot find it.
	"phpUnit": { "customPath": "vendor/bin/phpunit" }
}
