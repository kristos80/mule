<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
		 bootstrap="vendor/autoload.php"
		 cacheDirectory=".phpunit.cache"
		 colors="true"
		 executionOrder="random"
		 failOnRisky="true"
		 failOnWarning="true"
		 failOnNotice="true"
		 failOnDeprecation="true"
		 beStrictAboutOutputDuringTests="true">
	<testsuites>
		<testsuite name="unit">
			<directory>tests/Unit</directory>
		</testsuite>
	</testsuites>
	<source>
		<include>
			<directory>src</directory>
		</include>

		<!--
			The external layer: one primitive per method, no decision to assert.
			infection.json5 excludes the same two files, so the two lists stay
			visibly in step — one of them drifting is how a file stops being
			gated without anybody choosing that.

			They have no unit tests and are exercised by tests/Integration
			against a real temporary directory.
		-->
		<exclude>
			<file>src/External/PhpFilesystem.php</file>
			<file>src/External/PhpCoverageReport.php</file>
			<file>src/External/ComposerClasses.php</file>
		</exclude>
	</source>
</phpunit>
