/vendor/
/composer.lock
/node_modules/
/.phpunit.cache/
/.idea/
.DS_Store

# Everything machine-local lives under .mule/cache/, which ignores itself: mule
# writes a "*" in there on first run. The store beside it is committed on
# purpose — a content-hashed verdict is not machine-local state. Keeping the two
# in separate directories is what stops `git add .mule` committing a 61 MB shard
# cache. See docs/keying.md §4.
/.mule/cache/

# Until the pipeline writes into .mule/cache/ itself, the gate's own scratch:
/.cov/
/.infection/
/.mule/infection.json

# Rendered per run by the differential, the way mule renders one in earnest.
/tests/Fixture/project/infection.json5
